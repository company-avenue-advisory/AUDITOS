# Google Drive Auto-Sync Configuration
# =====================================

# Path to Google Drive service account JSON key file
# Download from: https://console.cloud.google.com/ → Service Accounts → Create Key
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# Client's Google Drive folder ID
# Where invoices are stored
# Format: https://drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=1G29eZJyd2dttQ4ghy2xNdr_h8YssX2nq

# Excel output path (where to save processed invoices)
GOOGLE_DRIVE_EXCEL_OUTPUT_PATH=/data/invoices_output.xlsx

# Webhook URL (for real-time sync; optional)
# Required only if using webhooks instead of CRON
# Format: https://yourdomain.com/api/google-drive-webhook
# GOOGLE_DRIVE_WEBHOOK_URL=https://yourdomain.com/api/google-drive-webhook

# Invoice type to extract: "sales", "purchase", or "both"
GOOGLE_DRIVE_INVOICE_TYPE=both

# Celery broker URL (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0

# =====================================
# Other AuditOS Configuration (existing)
# =====================================
# DATABASE_URL=...
# SENTRY_DSN=...
# etc.
