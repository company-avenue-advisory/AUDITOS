# Copy to .env on the droplet (chmod 600) and fill in real values.
# Never commit the filled-in .env — it holds live secrets.

# --- Postgres ---
POSTGRES_PASSWORD=

# --- Auth ---
JWT_SECRET_KEY=
ENVIRONMENT=production

# --- CORS: the Vercel frontend's origin(s), comma-separated, no wildcard ---
# e.g. https://auditos.vercel.app,https://auditos-yourteam.vercel.app
ALLOWED_ORIGINS=

# --- Storage ---
# Same service-account file as GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON below (already
# mounted read-only into the container) -- point straight at it, no need to
# duplicate the key as a raw JSON blob.
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/drive-service-account.json

# --- LLM providers ---
# Gemini is checked first if set (see backend/core/extraction/pipeline.py) --
# Groq/OpenRouter below are the fallback.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_BASE=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.3-70b-versatile

# --- Google Drive sync ---
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/app/secrets/drive-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_EXCEL_OUTPUT_PATH=/app/data/invoices_output.xlsx
GOOGLE_DRIVE_INVOICE_TYPE=both
